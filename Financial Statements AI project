        "## load data\n",
        "!pip install pandas requests --quiet\n",
        "\n",
        "import os\n",
        "import zipfile\n",
        "import requests\n",
        "import pandas as pd\n",
        "\n",
        "# URL from the dataset loading script\n",
        "url = \"https://huggingface.co/datasets/financial_phrasebank/resolve/main/data/FinancialPhraseBank-v1.0.zip\"\n",
        "zip_path = \"FinancialPhraseBank-v1.0.zip\"\n",
        "extract_dir = \"financial_phrasebank_data\"\n",
        "\n",
        "# Download zip\n",
        "r = requests.get(url)\n",
        "r.raise_for_status()\n",
        "\n",
        "with open(zip_path, \"wb\") as f:\n",
        "    f.write(r.content)\n",
        "\n",
        "# Extract\n",
        "with zipfile.ZipFile(zip_path, \"r\") as z:\n",
        "    z.extractall(extract_dir)\n",
        "\n",
        "# Path to the 75% agreement file\n",
        "txt_path = os.path.join(\n",
        "    extract_dir,\n",
        "    \"FinancialPhraseBank-v1.0\",\n",
        "    \"Sentences_75Agree.txt\"\n",
        ")\n",
        "\n",
        "# Read file\n",
        "rows = []\n",
        "with open(txt_path, encoding=\"iso-8859-1\") as f:\n",
        "    for line in f:\n",
        "        sentence, label = line.rsplit(\"@\", 1)\n",
        "        rows.append({\n",
        "            \"sentence\": sentence.strip(),\n",
        "            \"label_text\": label.strip()\n",
        "        })\n",
        "\n",
        "df = pd.DataFrame(rows)\n",
        "\n",
        "# Optional numeric encoding\n",
        "label_map = {\"negative\": 0, \"neutral\": 1, \"positive\": 2}\n",
        "df[\"label\"] = df[\"label_text\"].map(label_map)\n",
        "\n",
        "print(\"Dataset size:\", len(df))\n",
        "print(df[\"label_text\"].value_counts())\n",
        "df.head(20)"
      ]
