    {
      "cell_type": "code",
      "source": [
        "LABELS = [\"negative\", \"neutral\", \"positive\"]\n",
        "\n",
        "def classify_zero_shot(sentence: str, model: str = \"gpt-5-mini\"):\n",
        "    response = client.responses.create(\n",
        "        model=model,\n",
        "        instructions=(\n",
        "            \"You are a financial sentiment classifier. \"\n",
        "            \"Classify the sentiment of a single financial news sentence from an investor perspective. \"\n",
        "            \"Return exactly one label. \"\n",
        "            \"The allowed labels are: negative, neutral, positive.\"\n",
        "        ),\n",
        "        input=f\"Sentence: {sentence}\",\n",
        "        text={\n",
        "            \"format\": {\n",
        "                \"type\": \"json_schema\",\n",
        "                \"name\": \"financial_sentiment_label\",\n",
        "                \"strict\": True,\n",
        "                \"schema\": {\n",
        "                    \"type\": \"object\",\n",
        "                    \"properties\": {\n",
        "                        \"label\": {\n",
        "                            \"type\": \"string\",\n",
        "                            \"enum\": LABELS\n",
        "                        }\n",
        "                    },\n",
        "                    \"required\": [\"label\"],\n",
        "                    \"additionalProperties\": False\n",
        "                }\n",
        "            }\n",
        "        }\n",
        "    )\n",
        "    return json.loads(response.output_text)[\"label\"]\n",
        "\n",
        "# Call the function outside it\n",
        "print(classify_zero_shot(\"The company reported a strong increase in quarterly profit.\"))"
